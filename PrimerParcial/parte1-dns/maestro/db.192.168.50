; Tiempo de vida predeterminado de los registros.
$TTL 3600

; SOA de la zona inversa correspondiente a 192.168.50.0/24.
@       IN      SOA     ns1.empresa.local. admin.empresa.local. (
                        2026090501 ; Serial de la zona inversa
                        3600       ; Refresh
                        900        ; Retry
                        604800     ; Expiry
                        86400 )    ; Minimum TTL

; Servidores DNS autoritativos.
        IN      NS      ns1.empresa.local.
        IN      NS      ns2.empresa.local.

; Resolución inversa de 192.168.50.2.
2       IN      PTR     esclavo.empresa.local.

; Resolución inversa de 192.168.50.3.
3       IN      PTR     maestro.empresa.local.
