// Clave TSIG compartida con el maestro.
// Permite autenticar de forma segura las transferencias de zona.
include "/etc/bind/keys/esclavo.key";

// Zona directa empresa.local configurada como esclava.
zone "empresa.local" {
    type slave;

    // El maestro autorizado es 192.168.50.3 y la comunicación
    // para transferencia se autentica mediante esclavo-key.
    masters { 192.168.50.3 key esclavo-key; };

    // BIND almacena localmente la zona recibida del maestro.
    file "/var/cache/bind/db.empresa.local";
};

// Zona inversa de la red 192.168.50.0/24.
zone "50.168.192.in-addr.arpa" {
    type slave;

    // Maestro autorizado y autenticado mediante TSIG.
    masters { 192.168.50.3 key esclavo-key; };

    // Copia local de la zona inversa recibida del maestro.
    file "/var/cache/bind/db.192.168.50";
};
